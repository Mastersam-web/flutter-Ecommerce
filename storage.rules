rules_version = '2';

// Règles Firebase Storage — images des produits
// À publier : Console Firebase → Storage → Règles (ou firebase deploy --only storage)
service firebase.storage {
  match /b/{bucket}/o {

    // Images publiques, mais seul le vendeur propriétaire du dossier peut écrire
    match /products/{sellerId}/{fileName} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == sellerId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == sellerId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
