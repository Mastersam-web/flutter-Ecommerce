rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  RÈGLES DE SÉCURITÉ CLOUD FIRESTORE
//  À publier : Console Firebase → Firestore Database → Règles → Publier
//  (ou : firebase deploy --only firestore:rules)
// ═══════════════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── Fonctions utilitaires ─────────────
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSeller() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().role == 'seller';
    }

    function isClient() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userData().role == 'client';
    }

    // Un produit valide : champs obligatoires, prix > 0, stock entier >= 0
    function validProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 150
        && p.description is string
        && p.price is number && p.price > 0
        && p.stock is int && p.stock >= 0
        && p.currency in ['BIF', 'USD', 'EUR']
        && p.categoryId is string
        && p.imageUrl is string
        && p.sellerId is string
        && p.sellerName is string;
    }

    // Un client ne peut que DIMINUER le stock (achat), rien d'autre
    function stockDecreaseOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;
    }

    // ───────────── Utilisateurs ─────────────
    match /users/{userId} {
      // Chacun ne lit / n'écrit que son propre profil
      allow read: if signedIn() && request.auth.uid == userId;

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ['client', 'seller']
        && (request.resource.data.role != 'seller'
            || (request.resource.data.whatsappNumber is string
                && request.resource.data.whatsappNumber.size() > 0));

      // Le rôle et l'identifiant ne peuvent jamais être modifiés
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;

      allow delete: if false;
    }

    // ───────────── Catégories ─────────────
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isSeller();
      allow delete: if false;
    }

    // ───────────── Produits ─────────────
    match /products/{productId} {
      // Catalogue public : lisible sans compte
      allow read: if true;

      // Seul un vendeur authentifié crée un produit, à son nom
      allow create: if isSeller()
        && request.resource.data.sellerId == request.auth.uid
        && validProduct(request.resource.data);

      // Un vendeur modifie / supprime UNIQUEMENT ses produits ;
      // un client peut seulement diminuer le stock lors d'un achat
      allow update: if (isSeller()
                        && resource.data.sellerId == request.auth.uid
                        && request.resource.data.sellerId == request.auth.uid
                        && validProduct(request.resource.data))
                    || (isClient() && stockDecreaseOnly());

      allow delete: if isSeller() && resource.data.sellerId == request.auth.uid;
    }

    // ───────────── Commandes ─────────────
    match /orders/{orderId} {
      // Lecture : le client propriétaire OU le vendeur concerné
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
            || resource.data.sellerId == request.auth.uid);

      // Création : un client, pour lui-même, avec au moins un article
      allow create: if isClient()
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.currency in ['BIF', 'USD', 'EUR']
        && request.resource.data.deliveryOption in ['delivery', 'pickup']
        && request.resource.data.paymentStatus == 'paid';

      // Le vendeur concerné peut uniquement changer le statut de la commande
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus']);

      allow delete: if false;
    }

    // Tout le reste est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
